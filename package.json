{
  "name": "queue-inspect",
  "version": "0.0.1",
  "description": "A terminal interface for inspecting and managing BullMQ queues in Redis.",
  "type": "module",
  "main": "ui/index.tsx",
  "bin": {
    "queue-inspect": "./bin/queue-inspect.ts"
  },
  "files": [
    "bin",
    "server",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akadotsh/queue-inspect.git"
  },
  "homepage": "https://github.com/akadotsh/queue-inspect#readme",
  "bugs": {
    "url": "https://github.com/akadotsh/queue-inspect/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "start": "bun ./ui/index.tsx",
    "dev": "bun --watch ./ui/index.tsx",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "bullmq",
    "redis",
    "queue",
    "terminal",
    "tui"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opentui/core": "^0.5.9",
    "@opentui/react": "^0.5.9",
    "bullmq": "^6.3.2",
    "react": "^19.2.8"
  }
}
